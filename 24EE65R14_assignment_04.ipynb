        "# Create datasets (attention_mask is all 1s since no padding tokens)\n",
        "train_dataset1 = TensorDataset(train_encodings['input_ids'],torch.ones_like(train_encodings['input_ids']),train_labels.argmax(dim=1))\n",
        "\n",
        "val_dataset1 = TensorDataset(val_encodings['input_ids'],torch.ones_like(val_encodings['input_ids']),val_labels.argmax(dim=1))\n",
        "\n",
        "test_dataset1 = TensorDataset(test_encodings['input_ids'],torch.ones_like(test_encodings['input_ids']),test_labels.argmax(dim=1))\n",
        "\n",
        "# DataLoaders\n",
        "train_loader1 = DataLoader(train_dataset1, batch_size=32, shuffle=True)\n",
        "val_loader1 = DataLoader(val_dataset1, batch_size=32)\n",
        "test_loader1 = DataLoader(test_dataset1, batch_size=32)\n"
