        "        truncation=True,\n",
        "        max_length=64,\n",
        "        return_tensors='pt'\n",
        "    )\n",
        "    return encodings\n",
        "\n",
        "train_encodings = bert_tokenize_and_convert(train_tokens)\n",
        "val_encodings = bert_tokenize_and_convert(val_tokens)\n",
        "test_encodings = bert_tokenize_and_convert(test_tokens)\n"
