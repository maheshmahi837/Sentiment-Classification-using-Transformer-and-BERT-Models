        "    plt.plot(epochs_range, train_accuracies, label=\"Train Acc\")\n",
        "    plt.plot(epochs_range, val_accuracies, label=\"Val Acc\")\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Accuracy\")\n",
        "    plt.title(\"Accuracy Curve\")\n",
        "    plt.legend()\n",
